.version 8.5
.target sm_87
.address_size 64


.visible .entry testbrx(
    .param .u64 ctx,
    .param .u64 ctx2
)
{
    .reg .pred %p;
    .reg .u32  %op, %pc;
    .reg .u64  %r0, %r1, %maps;

    mov.u32 %pc, 0;
    ld.param.u64 %r0, [ctx2];
    ld.param.u64 %r1, [ctx];

    bra.uni BB_dispatch;

BB_add:
    add.u64 %r0, %r0, %r1;
    add.u32 %pc, %pc, 1;
    bra.uni BB_dispatch;

BB_sub:
    add.u32 %pc, %pc, 2;
    bra.uni BB_dispatch1;


BB_jmpc:
    add.u32 %pc, %pc, 3;
    bra.uni BB_dispatch;

BB_ldmap:
    add.u32 %pc, %pc, 4;
    bra.uni BB_dispatch;



BB_exit:
    ret;

targets: .branchtargets BB_add, BB_sub, BB_ldmap, BB_jmpc, BB_exit;

BB_dispatch:
    // ld.global.u32 %op, [%r1 + 0];
    mov.u32 %op, 4;
BB_dispatch1:
    brx.idx.uni %op, targets;

}







